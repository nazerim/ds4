-static bool qwen4_ngram_read(const ds4_model *m, const uint32_t *rows, size_t count, float *out) {
+static bool qwen4_ngram_read_impl(const ds4_model *m, const uint32_t *rows, size_t count, float *out) {
     if (!m || !m->ngram_tensor || m->ngram_fd < 0 || (count && (!rows || !out)) ||
         count > SIZE_MAX / (160u * sizeof(float))) {
         errno = EINVAL;
@@ -58543,6 +58584,17 @@ static bool qwen4_ngram_read(const ds4_model *m, const uint32_t *rows, size_t co
     return ok;
 }
 
+/* Timed entry point (see qwen4_ple_trace_note). Uninstrumented path is a
+ * direct tail call; decode-phase reads are timed and aggregated. */
+static bool qwen4_ngram_read(const ds4_model *m, const uint32_t *rows, size_t count, float *out) {
+    if (!qwen4_ple_trace_enabled() || !ds4_gpu_decode_phase())
+        return qwen4_ngram_read_impl(m, rows, count, out);
+    const double t0 = now_sec();
+    const bool ok = qwen4_ngram_read_impl(m, rows, count, out);
+    qwen4_ple_trace_note(now_sec() - t0, count);
+    return ok;
+}
