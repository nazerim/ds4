+/* DS4_QWEN4_PLE_TRACE: opt-in decode-side n-gram read wall-clock accounting.
+ * Pure measurement. When the env is unset this is a single tail call (no
+ * timing, no behavior/output change); when set, it only accumulates reads made
+ * while ds4_gpu_decode_phase() is set — i.e. token generation and MTP verify,
+ * not the overlapped prefill gather. Rows are read synchronously per call, so
+ * this wall-clock is the exposed disk-read cost on the decode critical path. */
+static int      g_ple_trace_init    = -1;     /* -1 unread, 0/1 cached env test */
+static double   g_ple_trace_sec     = 0.0;    /* cumulative decode pread seconds */
+static double   g_ple_trace_max     = 0.0;    /* slowest single read (seconds)   */
+static uint64_t g_ple_trace_calls   = 0;      /* decode-phase reads counted       */
+static uint64_t g_ple_trace_rows    = 0;      /* total rows (count) read          */
+static uint64_t g_ple_trace_gt1ms   = 0;      /* reads slower than 1 ms           */
+static uint64_t g_ple_trace_gt5ms   = 0;      /* reads slower than 5 ms           */
+
+static bool qwen4_ple_trace_enabled(void) {
+    if (g_ple_trace_init < 0)
+        g_ple_trace_init = getenv("DS4_QWEN4_PLE_TRACE") != NULL ? 1 : 0;
+    return g_ple_trace_init == 1;
+}
+
+static void qwen4_ple_trace_note(double sec, size_t rows) {
+    g_ple_trace_sec += sec;
+    g_ple_trace_calls++;
+    g_ple_trace_rows += rows;
+    if (sec > g_ple_trace_max)  g_ple_trace_max = sec;
+    if (sec > 1e-3)             g_ple_trace_gt1ms++;
+    if (sec > 5e-3)             g_ple_trace_gt5ms++;
+    if (g_ple_trace_calls % 100 == 0) {
+        fprintf(stderr, "ds4: PLE-TRACE decode calls=%llu rows=%llu rows/call=%.1f "
+                "pread_s=%.4f avg_us=%.1f max_us=%.1f gt1ms=%llu gt5ms=%llu\n",
+                (unsigned long long)g_ple_trace_calls,
+                (unsigned long long)g_ple_trace_rows,
+                g_ple_trace_calls ? (double)g_ple_trace_rows / g_ple_trace_calls : 0.0,
+                g_ple_trace_sec,
+                g_ple_trace_calls ? 1e6 * g_ple_trace_sec / g_ple_trace_calls : 0.0,
+                1e6 * g_ple_trace_max,
+                (unsigned long long)g_ple_trace_gt1ms,
+                (unsigned long long)g_ple_trace_gt5ms);
+    }
+}
