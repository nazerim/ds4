+/* Thinking-regime sampling defaults (WINDOW-PATCHES-20261103 P1): rebase
+ * the DeepSeek-style thinking defaults (DS4_DEFAULT_TEMPERATURE/TOP_P/
+ * MIN_P, ds4.h) at LAUNCH via DS4_THINK_TEMPERATURE / DS4_THINK_TOP_P /
+ * DS4_THINK_MIN_P for sampling A/Bs without rebuilds.  Unlike the tripwire
+ * knobs these are parsed EXACTLY ONCE in main() before serving, because the
+ * decode loop re-reads them per token block and the #3975-analog audit (see
+ * the mtp_spec_disabled hoist) forbids per-token getenv.  Strict parse,
+ * mirroring the budget-env doctrine: whole-string match, hex rejected
+ * ("0x10" must not parse), non-finite or out-of-range rejected; invalid or
+ * absent = the compiled default.  Explicit request values still win: the
+ * _set flags guard the use sites in the decode loop.  SCOPE NOTE: the
+ * thinking regime covers the WHOLE request (both channels) whenever
+ * thinking is enabled, not just in-span tokens - that is exactly how the
+ * Nov-03 temp-0.6 experiment reached the visible payload, so the startup
+ * banner is mandatory (strings + log both name the active values). */
+static float server_think_env_float(const char *name, float fallback,
+                                    float lo, float hi) {
+    const char *e = getenv(name);
+    if (!e || !*e) return fallback;
+    if (e[0] == '0' && (e[1] == 'x' || e[1] == 'X')) return fallback;
+    char *end = NULL;
+    float v = strtof(e, &end);
+    if (end == e || *end != '\0') return fallback;
+    if (!isfinite(v) || v < lo || v > hi) return fallback;
+    return v;
+}
+
+static float g_think_temperature = DS4_DEFAULT_TEMPERATURE;
+static float g_think_top_p = DS4_DEFAULT_TOP_P;
+static float g_think_min_p = DS4_DEFAULT_MIN_P;
+
+static void server_think_sampling_init(void) {
+    g_think_temperature = server_think_env_float("DS4_THINK_TEMPERATURE",
+                                                 DS4_DEFAULT_TEMPERATURE,
+                                                 0.0f, 10.0f);
+    g_think_top_p = server_think_env_float("DS4_THINK_TOP_P",
+                                           DS4_DEFAULT_TOP_P, 0.0f, 1.0f);
+    g_think_min_p = server_think_env_float("DS4_THINK_MIN_P",
+                                           DS4_DEFAULT_MIN_P, 0.0f, 1.0f);
 }
 
