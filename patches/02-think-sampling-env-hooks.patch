+/* Thinking-regime sampling env hooks (WINDOW-PATCHES-20261103 P1): strict
+ * whole-string float, hex rejected ("0x3" out, matching the budget-env
+ * doctrine), non-finite and out-of-range rejected, absent/garbage = the
+ * compiled default; init caches all three for the decode loop. */
+static void test_think_sampling_env(void) {
+    const float base = DS4_DEFAULT_TEMPERATURE;
+    unsetenv("DS4_THINK_TEMPERATURE");
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "0.6", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == 0.6f);
+    setenv("DS4_THINK_TEMPERATURE", "0x3", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "0.6abc", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "-0.5", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "11", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TEMPERATURE", "inf", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TEMPERATURE", base,
+                                       0.0f, 10.0f) == base);
+    setenv("DS4_THINK_TOP_P", "1.5", 1);
+    TEST_ASSERT(server_think_env_float("DS4_THINK_TOP_P", DS4_DEFAULT_TOP_P,
+                                       0.0f, 1.0f) == DS4_DEFAULT_TOP_P);
+    setenv("DS4_THINK_TEMPERATURE", "0.6", 1);
+    setenv("DS4_THINK_TOP_P", "0.9", 1);
+    unsetenv("DS4_THINK_MIN_P");
+    server_think_sampling_init();
+    TEST_ASSERT(g_think_temperature == 0.6f);
+    TEST_ASSERT(g_think_top_p == 0.9f);
+    TEST_ASSERT(g_think_min_p == DS4_DEFAULT_MIN_P);
+    unsetenv("DS4_THINK_TEMPERATURE");
+    unsetenv("DS4_THINK_TOP_P");
+    server_think_sampling_init();   /* leave globals at compiled defaults */
+    TEST_ASSERT(g_think_temperature == DS4_DEFAULT_TEMPERATURE &&
+                g_think_top_p == DS4_DEFAULT_TOP_P &&
+                g_think_min_p == DS4_DEFAULT_MIN_P);
 }
 
